DATABASE_URL=postgresql+psycopg2://supply:supply@db:5432/supply
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=480
SEED_ON_STARTUP=true
CORS_ORIGINS=*

# Set real values only in .env or the hosting platform. Never commit them.
ETS_ADMIN_PIN=replace-me
ETS_STOREKEEPER_PIN=replace-me
ETS_DEVELOPER_PIN=replace-me

LEGACY_WEBAPP_URL=
SOP_WEBAPP_URL=
SHEET_SYNC_INTERVAL_MINUTES=10
SLACK_TRANSACTIONS_WEBHOOK_URL=
SLACK_PURCHASE_WEBHOOK_URL=
