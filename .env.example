# Installation locale (le script start-local.ps1 génère ces secrets).
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRE_MINUTES=480
SEED_ON_STARTUP=true
CORS_ORIGINS=http://localhost:61938,http://127.0.0.1:61938

# Set real values only in .env or the hosting platform. Never commit them.
ETS_ADMIN_PIN=0000
ETS_STOREKEEPER_PIN=0000

LEGACY_WEBAPP_URL=
SHEET_SYNC_INTERVAL_MINUTES=10
SLACK_TRANSACTIONS_WEBHOOK_URL=
SLACK_PURCHASE_WEBHOOK_URL=
